# ── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Clé privée — back-end uniquement, ne JAMAIS l'exposer au front
SUPABASE_SERVICE_ROLE_KEY=
# Optionnel : JWT secret "legacy" (Settings → API → JWT Settings).
# Si vide, la vérification passe par le endpoint JWKS du projet (clés asymétriques).
SUPABASE_JWT_SECRET=

# ── Application ─────────────────────────────────────────────────────────────
# Environnement : development | production
ENVIRONMENT=development
# URL du front (redirections emails Supabase : reset password, confirmation)
FRONTEND_URL=http://localhost:5173
# Origines autorisées par CORS, séparées par des virgules
CORS_ORIGINS=http://localhost:5173

# ── Emailing (Brevo) ────────────────────────────────────────────────────────
# Compte gratuit : https://app.brevo.com → SMTP & API → API Keys (clé "xkeysib-...")
# EMAIL_SENDER_ADDRESS doit être un expéditeur validé dans Brevo
# (Senders & Domains → Senders). Vide => emails désactivés (no-op journalisé).
BREVO_API_KEY=
EMAIL_SENDER_NAME=
EMAIL_SENDER_ADDRESS=

# ── Paiements ────────────────────────────────────────────────────────────────
# Stripe (mode test) : https://dashboard.stripe.com/test/apikeys
# STRIPE_WEBHOOK_SECRET : `stripe listen --forward-to localhost:8000/api/payments/webhooks/stripe`
# en local, ou Dashboard → Webhooks en production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Flutterwave (mobile money) — module à venir, laisser vide pour l'instant
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
